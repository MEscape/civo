# /opt/civo/env/prod.env: runtime configuration of the PRODUCTION container (root:civo-deploy, 0640).
# Created by hand on the host, never committed, never touched by CI. Every variable is validated at
# start (src/lib/config); a missing one stops the container and names itself in the log.
# Reference: .env.example. The image sets NODE_ENV=production, PORT and HOSTNAME.

LOG_LEVEL=info

# Neon, POOLED connection string of the production branch, for a role that may read and write the
# tables but not alter them. CI migrates with a separate owner role (GitHub secret
# PRODUCTION_DATABASE_URL), never with this one.
DATABASE_URL=postgresql://REPLACE
AUTH_DATABASE_URL=postgresql://REPLACE

AUTH_ENABLED=true
AUTH_SECRET=REPLACE-with-32-or-more-random-characters
AUTH_PLATFORM_ADMIN_EMAILS=you@example.org

# Mail: smtp or resend (none is refused in production).
MAIL_PROVIDER=resend
MAIL_FROM=Civo <no-reply@example.com>
MAIL_API_KEY=REPLACE

# Rate limiting (Upstash Redis over REST). Cloudflare sets cf-connecting-ip itself; that is only
# trustworthy because the origin is reachable through Cloudflare alone (docs/deployment/cloudflare.md).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CLIENT_ADDRESS_SOURCE=cloudflare
UPSTASH_REDIS_REST_URL=https://REPLACE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE
RATE_LIMIT_SECRET=REPLACE-with-32-or-more-random-characters

# Neon Object Storage: production buckets and a credential scoped to them.
STORAGE_S3_ENDPOINT=https://REPLACE
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=REPLACE
STORAGE_S3_SECRET_ACCESS_KEY=REPLACE
STORAGE_S3_PUBLIC_BUCKET=civo-public
STORAGE_S3_PRIVATE_BUCKET=civo-private
STORAGE_PUBLIC_BASE_URL=https://REPLACE/civo-public

NEXT_PUBLIC_APP_URL=https://app.example.com

# Mapbox maps & geocoding (must match the image build-args so server CSP aligns with the client bundle).
NEXT_PUBLIC_EXTERNAL_MAPS_ALLOWED=true
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.REPLACE
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
