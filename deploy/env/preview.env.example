# /opt/civo/env/preview.env: runtime configuration SHARED BY ALL PREVIEW containers (root:civo-deploy,
# 0640). Created by hand on the host, never committed, never touched by CI.
#
# Nothing here may be a production value. DATABASE_URL, AUTH_DATABASE_URL and NEXT_PUBLIC_APP_URL
# are not here: civo-remote adds them per pull request (the Neon branch of that PR, the PR's host).
# Reference: .env.example.

LOG_LEVEL=info

AUTH_ENABLED=true
# Different from production, so a preview session or token is worthless there.
AUTH_SECRET=REPLACE-with-32-or-more-random-characters
AUTH_PLATFORM_ADMIN_EMAILS=you@example.org

# Mail goes to the Mailpit container of the host (alias "mailpit" on every preview network); it
# never leaves the machine. Read it through an SSH tunnel to 127.0.0.1:8025.
MAIL_PROVIDER=smtp
MAIL_FROM=Civo Preview <no-reply@preview.invalid>
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CLIENT_ADDRESS_SOURCE=cloudflare
# Counters are keyed by a hash that includes RATE_LIMIT_SECRET: with a secret of its own, previews
# can share the Upstash database with production without sharing a single counter.
UPSTASH_REDIS_REST_URL=https://REPLACE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE
RATE_LIMIT_SECRET=REPLACE-with-32-or-more-random-characters

# Preview buckets and a credential that cannot reach the production ones. All previews share them.
STORAGE_S3_ENDPOINT=https://REPLACE
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=REPLACE
STORAGE_S3_SECRET_ACCESS_KEY=REPLACE
STORAGE_S3_PUBLIC_BUCKET=civo-preview-public
STORAGE_S3_PRIVATE_BUCKET=civo-preview-private
STORAGE_PUBLIC_BASE_URL=https://REPLACE/civo-preview-public

# Mapbox maps & geocoding (shared public token matching the image build-args; server CSP reads these at boot).
NEXT_PUBLIC_EXTERNAL_MAPS_ALLOWED=true
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.REPLACE
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
