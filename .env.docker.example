# ==============================================================================
# CIVO - DOCKER COMPOSE ENVIRONMENT TEMPLATE
# Copy to `.env.docker` for local Docker orchestration. `.env.docker` contains
# active container secrets and must never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Timezone Configuration
# UTC on every machine keeps logs and database timestamps consistent.
# ------------------------------------------------------------------------------
TZ=UTC
PGTZ=UTC

# ------------------------------------------------------------------------------
# PostgreSQL Initialization (`postgres`)
# Applied when initializing an empty volume. Keep in step with `.env`.
# ------------------------------------------------------------------------------
POSTGRES_USER=civo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civo
AUTH_DATABASE_NAME=civo_auth

# ------------------------------------------------------------------------------
# Database Connection URLs (`migrate` & `app` containers)
# Inside Docker's bridge network, containers connect via service name `postgres`.
# Ensure the password matches `POSTGRES_PASSWORD` above!
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://civo:change-me@postgres:5432/civo
AUTH_DATABASE_URL=postgresql://civo:change-me@postgres:5432/civo_auth

# ------------------------------------------------------------------------------
# Redis REST Proxy & Upstash Client (`redis-rest` & `app`)
# Emulates Upstash's HTTP protocol locally in front of `redis:6379`.
#Keep `SRH_TOKEN` and `UPSTASH_REDIS_REST_TOKEN` identical.
# ------------------------------------------------------------------------------
SRH_MODE=env
SRH_TOKEN=change-me-redis-token
SRH_CONNECTION_STRING=redis://redis:6379
UPSTASH_REDIS_REST_URL=http://redis-rest:80
UPSTASH_REDIS_REST_TOKEN=change-me-redis-token
RATE_LIMIT_CLIENT_ADDRESS_SOURCE=none

# ------------------------------------------------------------------------------
# Mail / SMTP (`mailhog` & `app`)
# Routes outbound container emails to the MailHog container on port 1025.
# ------------------------------------------------------------------------------
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=mailhog
MAIL_SMTP_PORT=1025
MAIL_FROM="Civo <no-reply@civo.local>"

# ------------------------------------------------------------------------------
# Next.js Runtime & Authentication (`app`)
# Used when running the production container profile (`docker compose --profile production up`).
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
AUTH_ENABLED=true
AUTH_SECRET=change-me-at-least-32-chars-long-hex-or-base64
