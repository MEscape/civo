# ==============================================================================
# Docker Compose environment for the local services (`docker-compose.yml`).
#
#   cp .env.docker.example .env.docker
#
# Compose hands this file to postgres, redis-rest, seaweedfs, seaweedfs-init, migrate and app.
# `npm run dev` does NOT read it: the application reads `.env`, which holds the same credentials
# (marked [docker] there). Never commit `.env.docker`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL (stands in for Neon) - postgres
# ------------------------------------------------------------------------------

POSTGRES_USER=civo
# Only read when the data volume is first created: changing it later needs a new volume.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civo
# A second database in the same server for the authentication tables.
AUTH_DATABASE_NAME=civo_auth

# ------------------------------------------------------------------------------
# 2. Redis REST proxy (stands in for Upstash; the rate limiter's store) - redis-rest
# ------------------------------------------------------------------------------

SRH_MODE=env
# The bearer token the application sends: UPSTASH_REDIS_REST_TOKEN in .env.
SRH_TOKEN=change-me
# Compose service name, not localhost.
SRH_CONNECTION_STRING=redis://redis:6379

# ------------------------------------------------------------------------------
# 3. Object storage (SeaweedFS stands in for Neon Object Storage) - seaweedfs, seaweedfs-init
# ------------------------------------------------------------------------------

# The names are the application's own, so `.env` holds the same values.
STORAGE_S3_ACCESS_KEY_ID=change-me
STORAGE_S3_SECRET_ACCESS_KEY=change-me
STORAGE_S3_REGION=auto
# Created by seaweedfs-init. The public bucket is readable by anyone, the private one only with
# the credentials above or a signed URL.
STORAGE_S3_PUBLIC_BUCKET=civo-public
STORAGE_S3_PRIVATE_BUCKET=civo-private

# ------------------------------------------------------------------------------
# 4. Containers of the application - migrate, app (profile "production")
# ------------------------------------------------------------------------------

# Compose service names as hosts. The `app` container runs with NODE_ENV=production and so also
# needs https services, AUTH_ENABLED=true and RATE_LIMIT_ENABLED=true; `migrate` needs only these.
DATABASE_URL=postgresql://civo:change-me@postgres:5432/civo
AUTH_DATABASE_URL=postgresql://civo:change-me@postgres:5432/civo_auth
