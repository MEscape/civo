# ==============================================================================
# CIVO - LOCAL SERVICES (docker-compose.yml)
# Copy to `.env.docker`; the copy is git-ignored and must never be committed.
# Read only by `docker compose` (`npm run infra:up`), never by the app: the app's
# settings live in `.env`. These are local throwaway credentials; production
# secrets belong in Vercel, not in a file.
#
# The values below must agree with `.env`:
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB    -> DATABASE_URL
#   POSTGRES_USER / POSTGRES_PASSWORD / AUTH_DATABASE_NAME -> AUTH_DATABASE_URL
#   SRH_TOKEN                                          -> UPSTASH_REDIS_REST_TOKEN
# Generate secrets with: openssl rand -hex 24
# ==============================================================================

# PostgreSQL. Applied only when the data volume is first created; after changing
# them, delete the volume (`npm run infra:down -- -v`).
POSTGRES_USER=civo
POSTGRES_PASSWORD=<generate-a-password>
POSTGRES_DB=civo
AUTH_DATABASE_NAME=civo_auth

# Upstash-compatible REST endpoint on http://localhost:8079.
SRH_TOKEN=<generate-a-token>
