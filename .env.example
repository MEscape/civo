# ==============================================================================
# Application environment, read by `npm run dev`, `npm run build` and `npm start`.
#
#   cp .env.example .env     then replace everything marked REPLACE
#
# Every variable is validated at startup (src/lib/config); a missing or malformed one stops the
# app with a message naming it. Add one with `npm run gen -- env <NAME>`. Never commit `.env`.
#
# The local services (PostgreSQL, Redis, S3 storage, mail catcher) come from `docker compose`; the
# values below that must agree with `.env.docker` are marked [docker].
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime
# ------------------------------------------------------------------------------

# development | test | production. `next dev`, `next build` and the test runner set it
# themselves; set it only to start a production build by hand.
# NODE_ENV=development

# debug | info | warn | error. `debug` also logs every SQL statement (never its values).
LOG_LEVEL=info

# How long audit entries are kept, in days (30 to 3650).
# AUDIT_RETENTION_DAYS=365

# How long a booking is kept after its appointment ended, in days (30 to 3650). Then the booking,
# with the citizen's name and e-mail, is deleted daily. Pick what your records duty requires.
# BOOKING_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL; Neon in production)
# ------------------------------------------------------------------------------

# [docker] The password is POSTGRES_PASSWORD of .env.docker. For Neon use the pooled connection
# string with sslmode=require.
DATABASE_URL=postgresql://civo:change-me@localhost:5432/civo

# The pool: its size is a real limit on a managed database, a statement longer than the timeout
# is aborted by the database.
# DATABASE_POOL_SIZE=10
# DATABASE_POOL_TIMEOUT_SECONDS=10
# DATABASE_STATEMENT_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 3. Authentication
# ------------------------------------------------------------------------------

# false skips sign-in and acts as AUTH_DEV_ACTOR_ROLE. Refused in production.
AUTH_ENABLED=false

# The role acted as while AUTH_ENABLED=false.
AUTH_DEV_ACTOR_ROLE=platform_admin

# Signs sessions and tokens: 32+ random characters. Required once AUTH_ENABLED=true.
AUTH_SECRET=change-me-to-32-or-more-random-characters

# [docker] The database for the authentication tables (AUTH_DATABASE_NAME of .env.docker).
AUTH_DATABASE_URL=postgresql://civo:change-me@localhost:5432/civo_auth
# AUTH_DATABASE_POOL_SIZE=5

# Platform administrators by verified e-mail address: the bootstrap of a deployment. Each gets a
# single-use link by mail on start. Comma-separated.
# AUTH_PLATFORM_ADMIN_EMAILS=you@example.org

# Reverse proxies in front of the app (IPs or CIDR ranges, comma-separated). Read by the rate
# limiter's "proxies" source, see section 5.
AUTH_TRUSTED_PROXIES=10.0.0.0/8

# Session lifetimes, in seconds. Update and fresh age may not exceed the lifetime; the maximum
# may not be below it.
# AUTH_SESSION_EXPIRES_IN_SECONDS=604800
# AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# AUTH_SESSION_FRESH_AGE_SECONDS=900
# AUTH_SESSION_MAX_LIFETIME_SECONDS=2592000

# ------------------------------------------------------------------------------
# 4. Mail
# ------------------------------------------------------------------------------

# none | smtp | resend. none sends nothing (refused in production); resend is refused outside it.
# [docker] smtp with Mailpit catches every mail: web UI at http://localhost:8025.
MAIL_PROVIDER=smtp
MAIL_FROM=Civo <no-reply@civo.test>

# smtp only.
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=10225
# true connects over TLS from the first byte (typically port 465).
# MAIL_SMTP_SECURE=false
# An authenticated relay needs both; a local catcher needs neither.
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=

# resend only.
# MAIL_API_KEY=
# MAIL_API_URL=https://api.resend.com/emails

# ------------------------------------------------------------------------------
# 5. Rate limiting (Upstash Redis; Redis REST proxy locally)
# ------------------------------------------------------------------------------

# false skips rate limiting: every attempt is allowed and Redis is not needed. Refused in production.
RATE_LIMIT_ENABLED=true

# Who tells the application the client's address. Required, no default:
#   vercel | cloudflare | azure   the one header that platform sets itself
#   proxies                       x-forwarded-for through AUTH_TRUSTED_PROXIES (Oracle Cloud load
#                                 balancers, Azure Application Gateway / App Service, nginx, ...)
# Locally Next.js puts the socket address into x-forwarded-for, so "proxies" resolves 127.0.0.1;
# AUTH_TRUSTED_PROXIES must be non-empty and must not contain the loopback address.
RATE_LIMIT_CLIENT_ADDRESS_SOURCE=proxies

# [docker] The REST endpoint of the Redis; the token is SRH_TOKEN of .env.docker.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=change-me

# Keys the hash of every counter: 32+ characters. Unset: AUTH_SECRET is used.
RATE_LIMIT_SECRET=change-me-to-32-or-more-random-characters

# Upper bound for one limiter check, including the round trip to Redis (100 to 10000).
# RATE_LIMIT_TIMEOUT_MS=1500

# ------------------------------------------------------------------------------
# 6. Object storage (S3 protocol; Neon Object Storage in production)
# ------------------------------------------------------------------------------

# [docker] SeaweedFS. For Neon: its S3 endpoint, region, and the credential from `neon credentials
# create`. Buckets are addressed by path (endpoint/bucket/key). Browsers upload to signed URLs
# directly, so the endpoint must be reachable from the browser too.
STORAGE_S3_ENDPOINT=http://localhost:8333
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=change-me
STORAGE_S3_SECRET_ACCESS_KEY=change-me

# At least one bucket. The public one is readable by anyone through STORAGE_PUBLIC_BASE_URL; the
# private one only through short-lived signed URLs. They must differ.
STORAGE_S3_PUBLIC_BUCKET=civo-public
STORAGE_S3_PRIVATE_BUCKET=civo-private

# Where the public bucket is served from, bucket included for path-addressed services.
STORAGE_PUBLIC_BASE_URL=http://localhost:8333/civo-public

# ------------------------------------------------------------------------------
# 7. Integration tests (npm run test:integration)
# ------------------------------------------------------------------------------

# Each one is skipped, not passed, while its variables are unset. They use their own variables so a
# test can never write to a configured bucket or store by accident.

# [docker] The Redis REST proxy.
# RATE_LIMIT_TEST_REST_URL=http://localhost:8079
# RATE_LIMIT_TEST_REST_TOKEN=change-me

# [docker] SeaweedFS. Set STORAGE_TEST_ALLOW_REMOTE=true to run against a non-local endpoint.
# STORAGE_TEST_S3_ENDPOINT=http://localhost:8333
# STORAGE_TEST_S3_ACCESS_KEY_ID=change-me
# STORAGE_TEST_S3_SECRET_ACCESS_KEY=change-me
# STORAGE_TEST_S3_PUBLIC_BUCKET=civo-public
# STORAGE_TEST_S3_PRIVATE_BUCKET=civo-private
# STORAGE_TEST_PUBLIC_BASE_URL=http://localhost:8333/civo-public

# ------------------------------------------------------------------------------
# 8. Public (shipped to the browser, so never a secret)
# ------------------------------------------------------------------------------

# Origin the app is served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REPLACE: your Mapbox PUBLIC token (pk.…, https://account.mapbox.com/access-tokens/). Restrict it
# to your URLs in the Mapbox account. Never use a secret token (sk.…). Without one the map still
# renders a first-party geographic overview and a list; external street tiles stay off.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.REPLACE_WITH_YOUR_MAPBOX_PUBLIC_TOKEN

# A Mapbox-hosted style: mapbox://styles/<owner>/<style>.
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11

# External maps remain disabled by default. Set true only after documenting the lawful basis
# for Mapbox tiles, static images and geocoding, or after implementing a citizen consent gate.
NEXT_PUBLIC_EXTERNAL_MAPS_ALLOWED=false
# Optional development-only reference account password (at least 16 characters).
# When omitted, seed:wuerzburg generates .env.wuerzburg.local, which Git ignores.
# WUERZBURG_DEMO_PASSWORD=

