# ==============================================================================
# Copy to `.env` and fill in. Every variable is validated at startup by
# `@lib/config` (public) and `@lib/config/server` (server-only); a missing or
# malformed required value stops the app with a message naming it.
# Never commit real values: this file holds placeholders only.
# ==============================================================================

# ==============================================================================
# SERVER-ONLY ENVIRONMENT VARIABLES
# ==============================================================================

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# true (default) | false. `false` skips sign-in and acts as AUTH_DEV_ACTOR_ROLE;
# it is refused when NODE_ENV=production.
AUTH_ENABLED=false
AUTH_DEV_ACTOR_ROLE=admin

# Required while AUTH_ENABLED=true:
# AUTH_SECRET=<at least 32 random characters, e.g. `openssl rand -base64 48`>
# AUTH_DATABASE_URL=postgresql://username:password@localhost:5432/auth_database_name

# Optional (defaults in parentheses):
# AUTH_DATABASE_POOL_SIZE=5
# AUTH_SESSION_EXPIRES_IN_SECONDS=604800
# AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# AUTH_SESSION_FRESH_AGE_SECONDS=900
# AUTH_SESSION_MAX_LIFETIME_SECONDS=2592000
# Comma-separated proxy addresses whose forwarded client IP is trusted.
# AUTH_TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Mail (sign-in, invitations, bookings)
# ------------------------------------------------------------------------------
# none | smtp | resend
#   none    sends nothing (development only; production refuses it)
#   smtp    any SMTP server: Mailpit/MailHog locally, a relay in production
#   resend  Resend HTTP API (production only)
MAIL_PROVIDER=none
# Required as soon as MAIL_PROVIDER is not `none`.
# MAIL_FROM=Civo <no-reply@example.org>

# --- smtp ---
# MAIL_SMTP_HOST=localhost
# MAIL_SMTP_PORT=1025
# true = implicit TLS (usually port 465); false = plain or STARTTLS upgrade (587, 1025).
# MAIL_SMTP_SECURE=false
# Credentials of an authenticated relay; set both or neither. Not needed for Mailpit/MailHog.
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=

# --- resend ---
# MAIL_API_KEY=re_...
# MAIL_API_URL=https://api.resend.com/emails

# ==============================================================================
# PUBLIC / CLIENT-SIDE ENVIRONMENT VARIABLES (shipped to the browser)
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# A Mapbox PUBLIC token (pk.…), URL-restricted in your Mapbox account. Never a secret (sk.…) token.
# Without it the map falls back to a list.
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.…
# NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
