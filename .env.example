# ==============================================================================
# APPLICATION ENVIRONMENT TEMPLATE
# Copy to `.env` and fill in. Validated at startup by `@lib/config`.
# Never commit real values: this file holds placeholders only.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=development

# Options: debug | info | warn | error
LOG_LEVEL=info

# Days the website audit log keeps an entry (30-3650). Older entries deleted daily.
AUDIT_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# Database Connection (Required)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# Authentication System
# ------------------------------------------------------------------------------
# Set to `false` to skip sign-in (defaults to AUTH_DEV_ACTOR_ROLE). Refused in production.
AUTH_ENABLED=false
AUTH_DEV_ACTOR_ROLE=platform_admin

# Required when AUTH_ENABLED=true:
# AUTH_SECRET=<at least 32 random characters, e.g. `openssl rand -base64 48`>
# AUTH_DATABASE_URL=postgresql://username:password@localhost:5432/auth_database_name

# Platform administrators who can create/list websites.
# AUTH_PLATFORM_ADMIN_EMAILS=admin@example.org

# Optional Authentication Settings (Defaults shown):
# AUTH_DATABASE_POOL_SIZE=5
# AUTH_SESSION_EXPIRES_IN_SECONDS=604800
# AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# AUTH_SESSION_FRESH_AGE_SECONDS=900
# AUTH_SESSION_MAX_LIFETIME_SECONDS=2592000
# AUTH_TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Mail Configuration (Sign-in, Invitations, Bookings)
# ------------------------------------------------------------------------------
# Options: none | smtp | resend (none is for development only)
MAIL_PROVIDER=none

# Required if MAIL_PROVIDER is not `none`:
# MAIL_FROM="Civo <no-reply@example.org>"

# SMTP Server Settings (Required if MAIL_PROVIDER=smtp):
# MAIL_SMTP_HOST=localhost
# MAIL_SMTP_PORT=1025
# MAIL_SMTP_SECURE=false

# Authenticated SMTP Relay Credentials (Optional, not needed for Mailpit/MailHog):
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=

# Resend API Settings (Required if MAIL_PROVIDER=resend):
# MAIL_API_KEY=re_...
# MAIL_API_URL=https://api.resend.com/emails

# ==============================================================================
# PUBLIC / CLIENT-SIDE ENVIRONMENT VARIABLES
# Shipped to the browser.
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox Configuration (Public tokens only: pk.…)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.…
# NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
