# ==============================================================================
# SERVER-ONLY ENVIRONMENT VARIABLES
# ==============================================================================

NODE_ENV=development

# Application / Prisma database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Dedicated Better Auth database
AUTH_DATABASE_NAME=auth_database_name
AUTH_DATABASE_URL=postgresql://username:password@localhost:5432/auth_database_name

DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10

LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Auth — General
# ------------------------------------------------------------------------------
# Disable auth for local development and act as an admin automatically
AUTH_ENABLED=false
AUTH_DEV_ACTOR_ROLE=admin
# AUTH_SECRET=... (Only needed if AUTH_ENABLED=true)

# ------------------------------------------------------------------------------
# Mail (sign-in and bookings)
# ------------------------------------------------------------------------------
# Allowed values: none | resend | smtp
MAIL_PROVIDER=none
# MAIL_FROM=Civo <no-reply@example.org>

# --- Resend ---
# MAIL_API_KEY=re_...
# MAIL_API_URL=

# --- SMTP / Mailpit ---
# MAIL_SMTP_HOST=localhost
# MAIL_SMTP_PORT=1025

# ==============================================================================
# PUBLIC / CLIENT-SIDE ENVIRONMENT VARIABLES
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.…
# NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
