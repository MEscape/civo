// use prisma-8

enum PageConfigStatus {
  DRAFT
  PUBLISHED
}

enum ReleaseStatus {
  DRAFT
  PUBLISHED
  FAILED
  ROLLED_BACK
}

enum MigrationStatus {
  PROPOSED
  APPLIED
}

enum DataSourceKind {
  MOCK
  REST
}

enum DataSourceStatus {
  UNKNOWN
  OK
  ERROR
}

enum DatasetStatus {
  UNKNOWN
  OK
  ERROR
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

model Website {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String   @unique
  description String?
  templateKey String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  publishedReleaseId String? @unique

  pages       Page[]
  theme       WebsiteTheme?
  releases    WebsiteRelease[]
  migrations  WebsiteMigration[]
  dataSources DataSource[]
  bookingLocations  BookingLocation[]
  bookableResources BookableResource[]
  bookableServices  BookableService[]
  bookings          Booking[]
  publishedRelease WebsiteRelease? @relation("PublishedRelease", fields: [publishedReleaseId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
}

model Page {
  id        String   @id @default(uuid())
  tenantId  String
  websiteId String
  website   Website  @relation(fields: [websiteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  path      String
  title     String

  version   Int      @default(1)
  configs   PageConfig[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([websiteId, path])
}

model PageConfig {
  id        String           @id @default(uuid())
  pageId    String
  content   Json
  status    PageConfigStatus @default(DRAFT)
  version   Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now())

  page      Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
}

model WebsiteTheme {
  id             String  @id @default(uuid())
  websiteId      String  @unique
  primaryColor   String  @default("#1F3A34")
  secondaryColor String  @default("#7A8B85")
  accentColor    String  @default("#C9782F")
  headingFont    String  @default("Source Serif 4")
  bodyFont       String  @default("Inter")
  radius         String  @default("md")
  spacingScale   String  @default("comfortable")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model WebsiteRelease {
  id            String   @id @default(uuid())
  websiteId     String
  releaseNumber Int
  status        ReleaseStatus @default(DRAFT)
  snapshot      Json
  snapshotHash  String
  publishedAt   DateTime?
  createdAt     DateTime @default(now())

  website       Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  activeWebsites Website[] @relation("PublishedRelease")
  migrations    WebsiteMigration[]

  @@unique([websiteId, releaseNumber])
}

model WebsiteMigration {
  id              String          @id @default(uuid())
  websiteId       String
  sourceReleaseId String
  status          MigrationStatus @default(PROPOSED)
  plan            Json
  resolutions     Json?
  proposedBy      String
  appliedBy       String?
  createdAt       DateTime        @default(now())
  appliedAt       DateTime?

  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sourceRelease WebsiteRelease @relation(fields: [sourceReleaseId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
}

model DataSource {
  id            String    @id @default(uuid())
  websiteId     String
  name          String
  kind          DataSourceKind
  config        Json
  status        DataSourceStatus @default(UNKNOWN)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())

  website       Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  datasets      Dataset[]
}

model Dataset {
  id            String    @id @default(uuid())
  dataSourceId  String
  name          String
  slug          String
  canonicalKind String
  mapping       Json?
  status        DatasetStatus @default(UNKNOWN)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())

  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([dataSourceId, slug])
}

model Membership {
  id        String   @id @default(uuid())
  actorId   String
  tenantId  String
  role      String
  createdAt DateTime @default(now())

  @@unique([actorId, tenantId, role])
}

// ── Booking & scheduling ────────────────────────────────────────────────────
// Every booking table carries (websiteId, tenantId) and references the website
// by that pair, like Page: the database itself refuses a row whose tenant is
// not the website's tenant.

model BookingLocation {
  id           String   @id @default(uuid())
  tenantId     String
  websiteId    String
  name         String
  address      String?
  timeZone     String
  openingHours Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  website   Website            @relation(fields: [websiteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  resources BookableResource[]
  bookings  Booking[]

  @@index([websiteId])
}

model BookableResource {
  id           String   @id @default(uuid())
  tenantId     String
  websiteId    String
  locationId   String?
  name         String
  type         String
  skills       Json
  capacity     Int?
  availability Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  website  Website          @relation(fields: [websiteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  location BookingLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  holds    BookingResource[]

  @@index([websiteId])
}

model BookableService {
  id                     String   @id @default(uuid())
  tenantId               String
  websiteId              String
  name                   String
  description            String?
  category               String?
  isActive               Boolean  @default(true)
  durationMinutes        Int
  preparationMinutes     Int      @default(0)
  cleanupMinutes         Int      @default(0)
  slotIntervalMinutes    Int
  locationIds            Json
  requirements           Json
  participantsPerBooking Int      @default(1)
  participantsPerSession Int      @default(1)
  noticeMinutes          Int      @default(0)
  horizonDays            Int
  availability           Json?
  cancellation           Json
  rescheduling           Json
  information            Json
  requiredDocuments      Json
  instructions           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now())

  website  Website   @relation(fields: [websiteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  bookings Booking[]

  @@index([websiteId])
}

model Booking {
  id              String        @id @default(uuid())
  tenantId        String
  websiteId       String
  serviceId       String
  locationId      String
  reference       String        @unique
  status          BookingStatus
  start           DateTime
  end             DateTime
  occupiedStart   DateTime
  occupiedEnd     DateTime
  participants    Int
  sessionKey      String
  sessionCapacity Int
  customer        Json?
  customerEmail   String?
  holdExpiresAt   DateTime?
  rescheduleCount Int           @default(0)
  cancelledAt     DateTime?
  cancelledBy     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())

  website  Website           @relation(fields: [websiteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  service  BookableService   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  location BookingLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  holds    BookingResource[]

  @@index([websiteId, start])
  @@index([sessionKey])
  @@index([customerEmail])
  @@index([status, holdExpiresAt])
  @@check(expression: "\"start\" < \"end\" AND \"occupiedStart\" <= \"start\" AND \"end\" <= \"occupiedEnd\"", name: "Booking_span_check")
  @@check(expression: "\"participants\" >= 1 AND \"participants\" <= \"sessionCapacity\"", name: "Booking_group_size_rule")
}

// One row per resource a booking holds. It repeats the booking's occupied span,
// session key and liveness so a single table can carry the exclusion
// constraint that makes double booking impossible (see the migration).
model BookingResource {
  bookingId     String
  resourceId    String
  occupiedStart DateTime
  occupiedEnd   DateTime
  sessionKey    String
  isActive      Boolean

  booking  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource BookableResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([bookingId, resourceId])
  @@index([resourceId, occupiedStart])
  @@check(expression: "\"occupiedStart\" < \"occupiedEnd\"", name: "BookingResource_span_check")
}
