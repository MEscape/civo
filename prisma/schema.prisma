generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PageConfigStatus {
  DRAFT
  PUBLISHED
}

enum DataSourceKind {
  MOCK
  REST
}

enum DataSourceStatus {
  UNKNOWN
  OK
  ERROR
}

enum ReleaseStatus {
  DRAFT
  PUBLISHED
  FAILED
  ROLLED_BACK
}

enum MigrationStatus {
  PROPOSED
  APPLIED
}

model Theme {
  id             String   @id @default(uuid())
  primaryColor   String   @default("#0F172A")
  secondaryColor String   @default("#1E293B")
  accentColor    String   @default("#3B82F6")
  headingFont    String   @default("Inter")
  bodyFont       String   @default("Inter")
  radius         String   @default("8px")
  spacingScale   String   @default("1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  websites Website[]
}

model Website {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  description        String?
  templateKey        String?
  themeId            String?
  publishedReleaseId String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  theme            Theme?           @relation(fields: [themeId], references: [id], onDelete: SetNull)
  pages            Page[]
  dataSources      DataSource[]
  releases         WebsiteRelease[] @relation("WebsiteReleases")
  publishedRelease WebsiteRelease?  @relation("PublishedRelease", fields: [publishedReleaseId], references: [id], onDelete: Restrict)
  migrations       Migration[]
}

model Page {
  id        String   @id @default(uuid())
  websiteId String
  path      String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  website Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  configs PageConfig[]

  @@unique([websiteId, path])
}

model PageConfig {
  id        String           @id @default(uuid())
  pageId    String
  content   Json
  status    PageConfigStatus @default(DRAFT)
  version   Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model DataSource {
  id            String           @id @default(uuid())
  websiteId     String
  name          String
  kind          DataSourceKind
  config        Json // Kind-specific connection config (e.g. baseUrl, authMode)
  status        DataSourceStatus @default(UNKNOWN)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  website  Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  datasets Dataset[]
}

model Dataset {
  id            String           @id @default(uuid())
  dataSourceId  String
  name          String // Human-readable e.g. "Würzburg Veranstaltungen"
  slug          String // URL-safe key e.g. "events"
  canonicalType String // "Event" | "NewsItem" | "Service" | ... (see CanonicalType in domain)
  mapping       Json? // Field mapping from external shape to canonical type
  status        DataSourceStatus @default(UNKNOWN)
  lastFetchedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  // One dataset per slug per source (e.g. a source can't have two "events" datasets)
  @@unique([dataSourceId, slug])
}

model WebsiteRelease {
  id            String        @id @default(uuid())
  websiteId     String
  releaseNumber Int
  status        ReleaseStatus @default(DRAFT)
  snapshot      Json
  snapshotHash  String
  createdAt     DateTime      @default(now())
  publishedAt   DateTime?

  // Relations
  website            Website     @relation("WebsiteReleases", fields: [websiteId], references: [id], onDelete: Cascade)
  publishedByWebsite Website?    @relation("PublishedRelease")
  migrations         Migration[]

  @@unique([websiteId, releaseNumber])
}

model Migration {
  id              String          @id @default(uuid())
  websiteId       String
  sourceReleaseId String
  status          MigrationStatus @default(PROPOSED)
  planSnapshot    Json
  resolutions     Json
  createdAt       DateTime        @default(now())
  appliedAt       DateTime?

  // Relations
  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sourceRelease WebsiteRelease @relation(fields: [sourceReleaseId], references: [id])

  @@index([websiteId])
}
