[
  {
    "id": "column.public.Dataset.path",
    "label": "Add column \"path\" to \"Dataset\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "path",
        "table": "Dataset"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"path\" is missing",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "Dataset",
          "path"
        ]
      }
    ],
    "execute": [
      {
        "description": "add column \"path\"",
        "sql": "ALTER TABLE \"public\".\"Dataset\" ADD COLUMN \"path\" text"
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"path\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "Dataset",
          "path"
        ]
      }
    ]
  }
]