{
  "name": "civo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm run test && npm run test:architecture",
    "test": "vitest run __tests__/src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:architecture": "vitest run __tests__/architecture __tests__/eslint",
    "db:generate": "prisma contract emit",
    "db:migrate:check": "prisma migration check",
    "db:migrate:app": "prisma db migrate",
    "db:migrate:status": "prisma migration status",
    "db:migrate:auth": "tsx scripts/apply-auth-migration.ts",
    "db:migrate": "npm run db:migrate:app && npm run db:migrate:auth",
    "db:verify": "prisma db verify --strict",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "i18n:check": "vitest run __tests__/architecture/i18n-catalogs.test.ts"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/orm-family-sql": "8.0.0-rc.13",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@reduxjs/toolkit": "^2.13.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.5",
    "mapbox-gl": "^3.32.0",
    "neverthrow": "^8.2.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "prisma": "8.0.0-rc.17",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "prisma": "$prisma",
    "@prisma/dev": {
      "valibot": "^1.5.0",
      "@hono/node-server": "^1.19.15",
      "hono": "^4.13.5",
      "lodash": "^4.18.0"
    }
  }
}
